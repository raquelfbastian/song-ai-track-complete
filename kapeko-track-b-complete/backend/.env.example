# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ───────────────────────────────────────────────────────
# Supports: openai | anthropic | azure | groq | openai-compatible | ollama
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o
# Required for openai-compatible, custom, or ollama providers.
# LLM_BASE_URL=http://localhost:11434/v1

# Azure RAG embeddings: use the exact deployed embedding name.
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small-prod
# Set true only if using the local demo fallback.
AZURE_OPENAI_EMBEDDING_FALLBACK=false

# If using Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022

# If using Azure OpenAI:
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment
