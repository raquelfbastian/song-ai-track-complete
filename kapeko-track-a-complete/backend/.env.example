# Copy this to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ───────────────────────────────────────────────────────────
# Supports: azure | openai | groq
LLM_PROVIDER=azure
LLM_API_KEY=your-azure-api-key-here
LLM_MODEL=gpt-4o

# Azure OpenAI (if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment

# Groq (if LLM_PROVIDER=groq — FREE tier, no credit card)
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key-here
# LLM_MODEL=llama-3.1-8b-instant

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080

# ── Request protection ─────────────────────────────────────────────────────
# General API requests per IP within the window.
RATE_LIMIT_MAX=100
# AI-heavy requests per IP within the same window.
LLM_RATE_LIMIT_MAX=10
# Defaults to 15 minutes (900000 ms).
RATE_LIMIT_WINDOW_MS=900000
